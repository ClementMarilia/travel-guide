{
  "name": "@travel-guide/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.test.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test --test-reporter=spec \"test/unit/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.2",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "jsonwebtoken": "9.0.2",
    "pg": "latest",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "latest",
    "@types/pg": "latest",
    "prisma": "7.10.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
