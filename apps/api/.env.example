# PostgreSQL / Supabase connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# JWT secret used to sign access tokens. Generate a long random value locally or in your deployment platform.
JWT_SECRET="replace-with-a-long-random-secret"

# 32 random bytes, base64-encoded. Encrypts users' AI provider API keys at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# API port
PORT=3333

# Testing only: comma-separated host:port pairs the page verifier may reach even though they are
# private addresses. Leave unset in production.
# VERIFY_ALLOW_HOSTS=127.0.0.1:4466
